  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/guard.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/format_lint.py",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Agent|Task|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py post",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/notify.py start",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/notify.py stop",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py stop",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/notify.py attn",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py fail",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py agent-start",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/discipline.py agent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"if (-not (Test-Path -LiteralPath 'C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe')) { '[harness] WARNING: hook interpreter missing (C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe). All Python hooks (guard, discipline, format_lint, notify, session_context) are silently disabled. Tell the user and fix the interpreter path in ~/.claude/settings.json (uv python list --only-installed).' }\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/AppData/Roaming/uv/python/cpython-3.13.5-windows-x86_64-none/python.exe -I C:/Users/user/.claude/hooks/session_context.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "theme": "light",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: private. Working repositories are GitHub private repos of dewyfiower9440-hash: claude-config (~/.claude), dev-tools (C:\\dev\\tools), scaffold-ci-check, and future C:\\dev\\<project> repos",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main is the default branch of every repository; solo workflow commits directly to main; force-push is never allowed",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: GitHub account dewyfiower9440-hash only (private repositories listed under Trusted repo); no organizations",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured — bucket config scan did not complete cleanly, treat as unavailable, not absent",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: C:\\ itself is not a git repository. Trusted working repositories: ~/.claude (origin dewyfiower9440-hash/claude-config), C:\\dev\\tools (origin dewyfiower9440-hash/dev-tools), and project repositories under C:\\dev\\<project>",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  }
