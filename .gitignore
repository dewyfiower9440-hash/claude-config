# Whitelist: ~/.claude holds credentials, history, transcripts and caches.
# Track only hand-maintained configuration; everything else stays ignored.
/*
!/.gitignore
!/CLAUDE.md
!/settings.json
!/rules/
!/hooks/
!/skills/
!/agents/
!/tests/

# Inside tracked folders
/skills/synced/
__pycache__/
.ruff_cache/
.pytest_cache/
!/.gitattributes
!/.github/
!/pyrightconfig.json
!/ruff.toml
# Approved plan files are tracked (their history is evidence); nothing else under docs/.
!/docs/
/docs/*
!/docs/plans/
/docs/plans/*
!/docs/plans/*.md
# Closed plans: kept as history, out of the folder the hooks list.
!/docs/plans/archive/
/docs/plans/archive/*
!/docs/plans/archive/*.md
# Guides for working with this environment (Korean prose, English file names).
!/docs/guides/
/docs/guides/*
!/docs/guides/*.md
/tests/_tmp*/
