# Whitelist: ~/.claude holds credentials, history, transcripts and caches.
# Track only hand-maintained configuration; everything else stays ignored.
/*
!/.gitignore
!/CLAUDE.md
!/settings.json
!/rules/
!/hooks/
!/skills/
!/agents/
!/tests/

# Inside tracked folders
/skills/synced/
__pycache__/
.ruff_cache/
.pytest_cache/
!/.gitattributes
!/.github/
!/pyrightconfig.json
# Only the devenv master plan is tracked under docs/ (other plan files stay local).
!/docs/
/docs/*
!/docs/plans/
/docs/plans/*
!/docs/plans/2026-11-11-devenv-evolution-master.md
/tests/_tmp*/
